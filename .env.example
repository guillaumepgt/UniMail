# =============================================================================
# UniMail configuration
# Copy this file to `.env` and fill in the values. NEVER commit the real `.env`.
# =============================================================================

# --- Microsoft Entra ID app registration (personal Microsoft accounts) ---
# Application (client) ID from Azure Entra ID.
CLIENT_ID=
# Client secret from the app registration (Web platform).
CLIENT_SECRET=
# Redirect URI registered in Azure. MUST match exactly what Azure expects.
# The app runs a local callback server bound to this address.
REDIRECT_URI=http://localhost
# The app must be registered with Supported account types =
# "Accounts in any organizational directory and personal Microsoft accounts"
# (signInAudience: "AzureADandPersonalMicrosoftAccount").
#
# OAuth endpoints default to the /common authority, which signs in personal
# accounts reliably. Override only if you know what you're doing:
# AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
# TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token

# --- Encryption (AES-256-GCM) ---
# Master key used to encrypt refresh/access tokens at rest in SQLite.
# MUST be exactly 32 bytes, expressed as 64 hex characters.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Storage ---
# Path to the SQLite database file.
DATABASE_PATH=./unimail.db

# --- Multi-tenancy / API auth ---
# Comma-separated list of API keys allowed to call the REST API.
# Each key may optionally be mapped to a tenant with `key=tenant_id`.
# Example: API_KEYS=sk-prod-1=tenant-aaa,sk-prod-2=tenant-bbb
# A bare key (no "=") maps to DEFAULT_TENANT_ID.
API_KEYS=
# Tenant id assigned to accounts created without an explicit tenant.
DEFAULT_TENANT_ID=default

# --- REST API ---
# Address the Axum API server listens on.
API_BIND_ADDR=0.0.0.0:8080
# Optional override for the OAuth callback bind address.
# By default it is derived from REDIRECT_URI (localhost -> 127.0.0.1).
# In Docker, set this to 0.0.0.0:80 or the mapped callback port won't be
# reachable (docker-proxy forwards to the container's eth0, not its loopback).
# Leave empty for bare-metal / CLI use.
CALLBACK_BIND_ADDR=

# --- Token refresh policy ---
# Refresh tokens are refreshed in the background if they have not been used for
# this many days (accounts inactive for longer are "renewed" to stay connected).
TOKEN_INACTIVITY_DAYS=90
# How often (in seconds) the background refresh task runs.
REFRESH_INTERVAL_SECS=21600

# --- MCP ---
# No extra config: the MCP server shares the same DATABASE_PATH and ENCRYPTION_KEY.

# --- Logging ---
RUST_LOG=unimail=info,tower_http=info
